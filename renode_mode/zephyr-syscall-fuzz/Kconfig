config SYSCALL_FUZZ_SELFTEST
	bool "Harness self-test operations"
	help
	  Adds operations that deliberately trigger a kernel panic or a
	  kernel-mode CPU fault, to validate the AFL/Renode crash detection.
	  Never enable this for real fuzzing campaigns.

source "Kconfig.zephyr"

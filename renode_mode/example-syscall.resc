#!/usr/bin/env renode

py "import afl_syscall"

$elf?=@zephyr-syscall-fuzz.elf
mach create "syscall-fuzz"
machine LoadPlatformDescription $ORIGIN/cortex_r8_virtual.repl
cpu PerformanceInMips 50

# Loaded once: no "reset" macro, as LoadELF leaks ~175 KB of Renode memory per
# call. afl_syscall.py restores the loaded image itself after each reset.
sysbus LoadELF $elf

emulation SetGlobalQuantum "0.001"
emulation SetGlobalAdvanceImmediately true
# Started by afl_syscall.py once the first input has been written

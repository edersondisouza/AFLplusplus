#!/usr/bin/env bash

origin=$(readlink -f "$(dirname "$0")")

exec 197<&0

pipe=/tmp/afl.$$.$RANDOM
mkfifo $pipe

libdl_so=$(ldconfig -p 2>/dev/null | awk '/libdl\.so\.2 .*x86-64/ {print $NF; exit}')
for candidate in "$libdl_so" /lib/x86_64-linux-gnu/libdl.so.2 /usr/lib/libdl.so.2 /usr/lib64/libdl.so.2; do
    if [ -f "$candidate" ]; then
        libdl_so=$candidate
        break
    fi
done

if [ -f "$libdl_so" ]; then
    ln -fs "$libdl_so" libdl
fi
# Optional second argument: ELF to load, exposed to the script as $elf
elf_cmd=""
if [ -n "$2" ]; then
    elf_cmd="\$elf=@$(readlink -f "$2"); "
    export AFL_RENODE_ELF=$(readlink -f "$2")
fi

# Replace with the commented line below to gain access to Renode graphical interface
LD_LIBRARY_PATH="$(pwd)" renode --disable-xwt --console --hide-analyzers  -e "py \"sys.path.append('$origin/renode_mode'); import afl_renode\"; $elf_cmd i @$1; py \"afl_renode.start_fuzzing()\"" <$pipe &
#LD_LIBRARY_PATH="$(pwd)" renode -e "py \"sys.path.append('$origin/renode_mode'); import afl_renode\"; $elf_cmd i @$1; py \"afl_renode.start_fuzzing()\"" <$pipe &

exec >$pipe
rm $pipe
wait
